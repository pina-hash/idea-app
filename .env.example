# Supabase project credentials.
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). Never commit the real .env file.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY Supabase service-role key (Project Settings > API). Used by the
# GREENLINE community-track publish endpoint (/api/greenline-track-publish),
# which must validate submitted tracks in Node before writing — there is no
# client write path to greenline_tracks. Read at runtime via
# $env/dynamic/private, so leaving it blank is safe: publishing responds
# "not configured" and everything else works. NEVER expose this to the client
# and never prefix it PUBLIC_. Set it in the Vercel project env for production.
SUPABASE_SERVICE_ROLE_KEY=

# RETIRED, August 2026: COIN_API_KEY and COIN_LEDGER_URL. They configured the
# Google Sheets / Apps Script coin ledger, which is retired -- the IDEA Coin
# economy lives entirely in Supabase now. Both variables should be REMOVED from
# the Vercel project env; nothing reads them. See
# docs/coin-economy/archive/legacy-system/README.md for what they did.

# FSP tech-selection Apps Script endpoint (the /fsp-tech-selection tool posts
# freshman rankings here, and prefills via GET ?email=). Deploy the Google
# Apps Script web app, then paste its /exec URL here. Read at runtime via
# $env/dynamic/public, so leaving it blank is safe: the page loads and the
# picker works, it just shows "saving is not configured yet" instead of posting.
# PLACEHOLDER — replace with the real deployed /exec URL.
PUBLIC_FSP_APPS_SCRIPT_URL=

# Web Push (tournament match alerts). Generate a pair once with:
#   node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
# The PUBLIC key identifies this server to browser push services and is safe
# in the client bundle (read at runtime via $env/dynamic/public, so a missing
# value degrades to "alerts unavailable", never a build break). The PRIVATE
# key signs every push send and is SERVER-ONLY ($env/dynamic/private): NEVER
# prefix it PUBLIC_, never commit it. Both keys must come from the SAME pair
# or every send is rejected. Set both in the Vercel project env. Subscriptions
# are minted against the public key, so changing the pair orphans existing
# subscriptions (they fail silently and users re-enable).
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional VAPID contact (mailto: or https: URL) sent to push services with
# each push; defaults to https://ideabosco.com in src/lib/server/push.ts.
VAPID_SUBJECT=

# FSP Pulse Check Apps Script endpoint (the /fsp-pulse tool posts FRC interest
# + pathway pulse rankings here, and prefills via GET ?email=). Deploy the
# Google Apps Script web app, then paste its /exec URL here. Read at runtime
# via $env/dynamic/public, so leaving it blank is safe: the page loads and the
# picker works, it just shows "saving is not configured yet" instead of posting.
# PLACEHOLDER — replace with the real deployed /exec URL.
PUBLIC_FSP_PULSE_APPS_SCRIPT_URL=

# SERVER-ONLY digital-notebook Drive integration (src/lib/server/notebook-drive.ts,
# the only module that reads these). Photo uploads from /api/notebook/upload and
# /api/notebook/add-photo land in a folder inside a Google SHARED DRIVE;
# Postgres stores only the Drive file id (migration 0069).
#
# Auth is OAUTH ON BEHALF OF A REAL BOSCO TECH ACCOUNT, not a service account:
# the shared drive blocks any identity outside the school's Workspace domain,
# so a service account can never be granted access. Setup:
#   1. In Google Cloud, enable the Drive API and create an OAuth client
#      (type "Web application") whose authorized redirect URI is EXACTLY
#      https://ideabosco.com/admin/drive-connect/callback
#   2. Set GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET in the Vercel
#      project env and redeploy.
#   3. As a site ADMIN (0067), visit https://ideabosco.com/admin/drive-connect
#      once and approve access, signed in as a school account that can write
#      to the notebook folder in the shared drive. The consent asks for the
#      FULL https://www.googleapis.com/auth/drive scope (not drive.file: the
#      target folder pre-exists in the shared drive, and drive.file cannot
#      reliably create files inside a folder the app neither created nor was
#      granted through a Picker flow). The callback displays a
#      refresh token EXACTLY ONCE (never logged, never stored server-side).
#   4. Copy it into the Vercel project env as GOOGLE_DRIVE_REFRESH_TOKEN and
#      redeploy. Uploads work from the next deploy.
# All three are read at runtime via $env/dynamic/private, so leaving them blank
# is safe: the two notebook upload routes answer 503 "not configured" and
# nothing else is affected. NEVER prefix any of them with PUBLIC_.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional override for the notebook photo folder (a folder INSIDE the shared
# drive, not a shared-drive root). The current folder id is the default in
# src/lib/server/notebook-drive.ts -- the literal in the code is the working
# value and this var is only the override -- so it only needs setting if the
# folder ever moves.
GOOGLE_DRIVE_NOTEBOOK_FOLDER_ID=

# GitHub export for classroom specs (0110). A FINE-GRAINED personal access
# token scoped to Contents: read and write on pina-hash/idea-app AND NOTHING
# ELSE -- it exists to commit one folder of JSON under materials/, so a classic
# token or a broader scope is more access than the feature can use.
#
# Read at runtime via $env/dynamic/private by src/lib/server/classroom-export.ts
# and by nothing else, so leaving it BLANK is safe and is the normal state for
# local development: the export is skipped silently, no failure is recorded, and
# no chip appears anywhere. Set it in the Vercel project env for production.
# NEVER expose it to the client and never prefix it PUBLIC_.
GITHUB_EXPORT_TOKEN=

# ---------------------------------------------------------------------------
# IDEA FOUNDRY BUNDLE PROXY (the origin split).
#
# Student bundles must never execute on the origin that holds a signed-in
# student's session, so they are served from a SECOND HOST on the same Vercel
# project. Two origins rather than one host plus a header, because a header
# governs scripting and document origin but NOT whether a subresource request
# carries cookies: a bundle containing <img src="/api/whatever"> served
# same-host reaches the real backend with the viewer's cookies attached, and
# served cross-site it reaches a host that reaches nothing.
#
# PUBLIC_FOUNDRY_APPS_HOST is the bundle host, WITHOUT a scheme and WITH a port
# if there is one. Production: apps.ideabosco.com. Read at runtime via
# $env/dynamic/public, and UNSET IS SAFE AND FAILS CLOSED -- with no second
# origin configured, nothing is the apps host, so /r/* and /_platform/* 404
# everywhere and no bundle is served at all. It never degrades to serving them
# from the main origin.
#
# LOCALLY, point it at 127.0.0.1:5173 and open the app on
# http://localhost:5173. Those are different ORIGINS to a browser but the same
# dev server, so one `npm run dev` gives a genuine cross-origin test.
PUBLIC_FOUNDRY_APPS_HOST=127.0.0.1:5173

# The main app's origin, WITH the scheme. It is the CSP `frame-ancestors` value
# on every bundle response, so only the portal may frame a published app.
# Production: https://ideabosco.com. Unset means `frame-ancestors 'none'` --
# fail-closed, costing the gallery its embed rather than letting any site on
# the internet frame a bundle.
PUBLIC_FOUNDRY_APP_ORIGIN=http://localhost:5173

# SERVER-ONLY. Signs the bundle tokens (HMAC-SHA256) that authorize a read on
# the apps host, which has no session to read because the viewer's cookies are
# not sent to it. Read at runtime via $env/dynamic/private by
# src/lib/server/foundry-token.ts and by nothing else. NEVER prefix it PUBLIC_,
# never log it, never put it in an error message.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# LEAVING IT BLANK IS SAFE IN DEVELOPMENT ONLY: a per-process secret is
# generated, so tokens work and do not survive a restart. In PRODUCTION an
# unset value is not papered over -- the mint answers a structured
# "not_configured" and the proxy refuses every token -- because a per-instance
# secret on a platform that runs many instances would mint tokens that verify
# on one instance and nowhere else, which looks like anything except a missing
# variable.
FOUNDRY_TOKEN_SECRET=
