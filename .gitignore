.DS_Store
node_modules

# SvelteKit / Vite build output
/build
/.svelte-kit
/package
.vercel
.output

# Environment (never commit real keys)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor
.idea
.vscode/*
!.vscode/extensions.json

# Legacy static site clone (temp, never committed)
.legacy-src/

# Dev-harness feedback exports (not source)
idea-feedback-*.json
idea-feedback-*.md

# Supabase CLI scratch (project ref, cached version). Never committed.
supabase/.temp/

# tools/run-tests.mjs's JSON report, read once and deleted in its own
# `finally`. This is a backstop for a run a CI timeout kills outright, which
# skips that finally block.
.vitest-result-*.json

# Generated by `npm run history:index`. The indexes over docs/history/ are
# printed on demand and never committed: a committed index is one shared line
# that every session edits, which is the write point the 2026-08-28 split of
# docs/HISTORY.md removed.
docs/history/_generated/
