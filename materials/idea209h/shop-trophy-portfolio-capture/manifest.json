      "criteria": [
        {
          "id": "records-present",
          "text": "Station records present, readable, identified",
          "levels": [
            {
              "label": "Complete",
              "short": "5 readable, machine and part",
              "points": 6,
              "descriptor": "All five station records uploaded, every one readable, and every one names its machine and its part."
            },
            {
              "label": "Proficient",
              "short": "5 records, one gap",
              "points": 5,
              "descriptor": "All five present with one hard to read, or one missing its machine or part."
            },
            {
              "label": "Developing",
              "short": "3 or 4 records",
              "points": 2,
              "descriptor": "Three or four station records present."
            },
            {
              "label": "Absent",
              "short": "2 or fewer",
              "points": 0,
              "descriptor": "Two station records or fewer."
            }
          ],
          "points": 6
        },
        {
          "id": "settings-tooling",
          "text": "Settings and tooling as used",
          "levels": [
            {
              "label": "Complete",
              "short": "All 5 carry settings and tool",
              "points": 15,
              "descriptor": "All five records carry the settings actually used at that machine and name the tool or workholding used, in terms specific to that machine."
            },
            {
              "label": "Proficient",
              "short": "One gap in one record",
              "points": 12,
              "descriptor": "One of the two is missing from one record, or one record gives planned rather than used values."
            },
            {
              "label": "Developing",
              "short": "Gaps in 2 or 3",
              "points": 6,
              "descriptor": "One or both missing from two or three records, or those records name the operation only."
            },
            {
              "label": "Absent",
              "short": "Gaps in most",
              "points": 0,
              "descriptor": "Settings and tooling are absent from most records."
            }
          ],
          "points": 15
        },
        {
          "id": "what-happened",
          "text": "What happened at the machine",
          "levels": [
            {
              "label": "Complete",
              "short": "All 5 record a real event",
              "points": 14,
              "descriptor": "All five records name something that actually happened at that machine: a problem, a mistake, a measurement that came out wrong, or something changed mid-cut."
            },
            {
              "label": "Proficient",
              "short": "4 record a real event",
              "points": 11,
              "descriptor": "Four records name a specific event; one is a general statement."
            },
            {
              "label": "Developing",
              "short": "2 or 3 record an event",
              "points": 5,
              "descriptor": "Two or three records name a specific event."
            },
            {
              "label": "Absent",
              "short": "0 or 1",
              "points": 0,
              "descriptor": "One record or none names anything that happened."
            }
          ],
          "points": 14
        }
      ]
    },
