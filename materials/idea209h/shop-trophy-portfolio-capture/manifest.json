      "points": 25,
      "criteria": [
        {
          "id": "drawings-present",
          "text": "Drawings present and legible",
          "levels": [
            {
              "label": "Complete",
              "short": "5 legible drawings",
              "points": 6,
              "descriptor": "All five drawings uploaded and every one is legible."
            },
            {
              "label": "Proficient",
              "short": "5, one hard to read",
              "points": 5,
              "descriptor": "All five present with one hard to read."
            },
            {
              "label": "Developing",
              "short": "3 or 4 drawings",
              "points": 2,
              "descriptor": "Three or four drawings present."
            },
            {
              "label": "Absent",
              "short": "2 or fewer",
              "points": 0,
              "descriptor": "Two drawings or fewer."
            }
          ],
          "points": 6
        },
        {
          "id": "manufacturable",
          "text": "Manufacturable from the drawing",
          "levels": [
            {
              "label": "Complete",
              "short": "All 5 fully dimensioned",
              "points": 19,
              "descriptor": "All five drawings carry every dimension and feature needed to make the part with no guessing, and the topper sketch marks its 2.5 inch limit and its center hole."
            },
            {
              "label": "Proficient",
              "short": "One gap in one drawing",
              "points": 15,
              "descriptor": "One dimension or feature missing from one drawing, or the topper sketch is missing one of its two constraint marks."
            },
            {
              "label": "Developing",
              "short": "Gaps in 2 or 3",
              "points": 7,
              "descriptor": "Dimensions or features missing from two or three drawings."
            },
            {
              "label": "Absent",
              "short": "Gaps in most",
              "points": 0,
              "descriptor": "Most drawings could not be used to make the part."
            }
          ],
          "points": 19
        }
      ]
