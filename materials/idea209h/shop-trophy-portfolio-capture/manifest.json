    {
      "id": "assembly",
      "title": "Assemble the trophy",
      "blocks": [
        {
          "id": "cap-trophy",
          "type": "image",
          "field": "trophy",
          "prompt": "Photo of the assembled trophy"
        },
        {
          "id": "cap-fit",
          "type": "longText",
          "field": "fit",
          "prompt": "What did not fit, and why do you think it did not?",
          "minSentences": 3
        }
      ],
      "points": 15,
      "criteria": [
        {
          "id": "assembled",
          "text": "Assembled and photographed",
          "levels": [
            {
              "label": "Complete",
              "short": "Assembled, standing, clear",
              "points": 4,
              "descriptor": "Photo shows the trophy assembled from all five parts and standing on its own."
            },
            {
              "label": "Proficient",
              "short": "Assembled, poor photo",
              "points": 3,
              "descriptor": "Trophy is assembled but the photo is unclear or does not show all five parts."
            },
            {
              "label": "Developing",
              "short": "Partly assembled",
              "points": 1,
              "descriptor": "Some parts assembled, or parts shown laid out rather than together."
            },
            {
              "label": "Absent",
              "short": "No photo",
              "points": 0,
              "descriptor": "No assembly photo uploaded."
            }
          ],
          "points": 4
        },
        {
          "id": "what-fit",
          "text": "What fit and what did not",
          "levels": [
            {
              "label": "Complete",
              "short": "Named part, feature, reason",
              "points": 11,
              "descriptor": "Names the specific part and feature that did not fit, or the tightest fit if all fit, and gives a reason tied to how it was made or measured."
            },
            {
              "label": "Proficient",
              "short": "Named, reason thin",
              "points": 9,
              "descriptor": "Names the part and feature but the reason is general."
            },
            {
              "label": "Developing",
              "short": "General statement",
              "points": 4,
              "descriptor": "Says something fit or did not without naming the part or feature."
            },
            {
              "label": "Absent",
              "short": "Nothing written",
              "points": 0,
              "descriptor": "No response."
            }
          ],
          "points": 11
        }
      ]
    }
  ],
  "schemaVersion": 3
