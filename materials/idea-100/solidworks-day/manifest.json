      "points": 6,
      "audience": "individual",
      "criteria": [
        {
          "id": "steps",
          "text": "A screenshot for every wrench step, each showing what its step asks for",
          "levels": [
            {
              "label": "Complete",
              "short": "All twelve",
              "points": 6,
              "descriptor": "Twelve screenshots, each showing what its step's You should see line describes."
            },
            {
              "label": "Proficient",
              "short": "Nine to eleven",
              "points": 4,
              "descriptor": "Nine to eleven steps have a matching screenshot."
            },
            {
              "label": "Developing",
              "short": "One to eight",
              "points": 2,
              "descriptor": "One to eight steps have a matching screenshot."
            },
            {
              "label": "Absent",
              "short": "None",
              "points": 0,
              "descriptor": "No screenshots."
            }
          ],
          "points": 6
        }
      ]
    },
    {
      "id": "swd-hook",
      "title": "Your V1",
      "blocks": [
        {
          "id": "swd-hook-shot",
          "type": "image",
          "field": "ownShot",
          "prompt": "Screenshot of your V1 so far, file name showing"
        },
        {
          "id": "swd-hook-note",
          "type": "longText",
          "field": "ownNote",
          "prompt": "What you made so far, and what stopped you or what you figured out alone",
          "minSentences": 2
        },
        {
          "id": "swd-drill-1",
          "type": "image",
          "field": "d1",
          "prompt": "Drill 1 screenshot: lines and arcs, one tool",
          "optional": true
        },
        {
          "id": "swd-drill-2",
          "type": "image",
          "field": "d2",
          "prompt": "Drill 2 screenshot: a path into a band",
          "optional": true
        },
        {
          "id": "swd-drill-3",
          "type": "image",
          "field": "d3",
          "prompt": "Drill 3 screenshot: check the rules",
          "optional": true
        }
      ],
      "points": 4,
      "audience": "individual",
      "criteria": [
        {
          "id": "start",
          "text": "V1 is started from the student's own sketch and saved under the V1_ name",
          "levels": [
            {
              "label": "Complete",
              "short": "Started, named",
              "points": 2,
              "descriptor": "The screenshot shows V1_ and the student's last name at the top, and at least the two rule circles sized from their own sketch."
            },
            {
              "label": "Developing",
              "short": "Misnamed or empty",
              "points": 1,
              "descriptor": "A part, but misnamed, or nothing from their own design in it yet."
            },
            {
              "label": "Absent",
              "short": "No screenshot",
              "points": 0,
              "descriptor": "No screenshot."
            }
          ],
          "points": 2
        },
        {
          "id": "note",
          "text": "Two sentences on what was made and what stopped them or what they solved alone",
          "levels": [
            {
              "label": "Complete",
              "short": "Both, specific",
              "points": 2,
              "descriptor": "Says what they built and names a specific problem and what they did about it."
            },
            {
              "label": "Developing",
              "short": "Vague",
              "points": 1,
              "descriptor": "One sentence, or nothing specific."
            },
            {
              "label": "Absent",
              "short": "Blank",
              "points": 0,
              "descriptor": "Nothing written."
            }
          ],
          "points": 2
        }
      ]
    }
  ],
