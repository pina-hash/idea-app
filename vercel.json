{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": {
			"claude/**": false,
			"codex/**": false,
			"integration": false
		}
	},
	"redirects": [
		{
			"source": "/(.*)",
			"destination": "https://ideabosco.com/$1",
			"permanent": true,
			"has": [{ "type": "host", "value": "idea-app-sage.vercel.app" }]
		}
	]
}
