{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "npm test -- --no-file-parallelism && npm run build",
	"redirects": [
		{
			"source": "/(.*)",
			"destination": "https://ideabosco.com/$1",
			"permanent": true,
			"has": [{ "type": "host", "value": "idea-app-sage.vercel.app" }]
		}
	]
}
