{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": {
			"claude/**": false,
			"codex/**": false,
			"integration": false
		}
	},
	"redirects": [
		{
			"source": "/(.*)",
			"destination": "https://ideabosco.com/$1",
			"permanent": true,
			"has": [{ "type": "host", "value": "idea-app-sage.vercel.app" }]
		}
	],
	"crons": [
		{ "path": "/api/coin/autopay", "schedule": "17 10 * * *" },
		{ "path": "/api/certifications/jobs/daily", "schedule": "41 10 * * *" }
	]
}
